PORT=3000
DB_PATH=./data/trustsign.db
APPROVAL_THRESHOLD_VND=50000000
TX_TTL_HOURS=24
NONCE_TTL_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
MAX_DEVICES_PER_USER=3
SESSION_TTL_MINUTES=30
# Email OTP: điền SMTP host/port/tài khoản gửi và email nhận của admin.
ADMIN_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_PEPPER=
# Giới hạn tốc độ cho /auth/login, /auth/mfa và /auth/mfa/resend (số lần / phút / IP)
RATE_LIMIT_MAX=5
